# Configuração do servidor
SONGFINDER_HOST=0.0.0.0
SONGFINDER_PORT=3000
SONGFINDER_TEMP_DIR=./tmp
SONGFINDER_CACHE_TTL_HOURS=168
SONGFINDER_MAX_CONCURRENT_TASKS=4
SONGFINDER_YTDLP_PATH=yt-dlp
SONGFINDER_YTDLP_COOKIES_FILE=
SONGFINDER_YTDLP_EXTRA_ARGS=
SONGFINDER_FFMPEG_PATH=ffmpeg

# Provedor: AcoustID (obtenha chave gratuita em https://acoustid.org/api-key)
SONGFINDER_ACOUSTID__API_KEY=sua_chave_aqui
SONGFINDER_ACOUSTID__FPCALC_PATH=fpcalc

# Provedor: ACRCloud (obtenha chaves em https://console.acrcloud.com/)
SONGFINDER_ACRCLOUD__HOST=identify-{regiao}.acrcloud.com
SONGFINDER_ACRCLOUD__ACCESS_KEY=sua_access_key
SONGFINDER_ACRCLOUD__ACCESS_SECRET=sua_access_secret

# --- Anúncios (House Ads) ---
# Os anúncios são configurados via JSON no arquivo config/ads.toml
# Exemplo de config/ads.toml:
#
# [[ads.house]]
# slot = "top-banner"
# image_url = "https://exemplo.com/banner.png"
# dest_url = "https://exemplo.com"
# alt = "Anúncio exemplo"
# cpm = 0.50
#
# [[ads.house]]
# slot = "middle-banner"
# image_url = "https://exemplo.com/banner2.png"
# dest_url = "https://exemplo.com"
# alt = "Outro anúncio"
# cpm = 0.75
